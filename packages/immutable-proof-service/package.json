{
	"name": "@twin.org/immutable-proof-service",
	"version": "0.0.3-next.10",
	"description": "Immutable proof contract implementation and REST endpoint definitions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/immutable-proof.git",
		"directory": "packages/immutable-proof-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "npm run docs:clean && npm run docs:generate && npm run docs:api",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run test:build && npm run docs"
	},
	"dependencies": {
		"@twin.org/api-models": "next",
		"@twin.org/background-task-models": "next",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/event-bus-models": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/immutable-proof-models": "0.0.3-next.10",
		"@twin.org/immutable-proof-task": "0.0.3-next.10",
		"@twin.org/logging-models": "next",
		"@twin.org/verifiable-storage-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/standards-w3c-did": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/background-task-service": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/identity-connector-entity-storage": "next",
		"@twin.org/logging-connector-entity-storage": "next",
		"@twin.org/verifiable-storage-connector-entity-storage": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/ts-to-openapi": "next",
		"@types/node": "24.10.1",
		"@vitest/coverage-v8": "4.0.8",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.11",
		"rimraf": "6.1.0",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.14",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "4.0.8"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"immutable-proof",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/immutable-proof/issues"
	},
	"homepage": "https://twindev.org"
}
