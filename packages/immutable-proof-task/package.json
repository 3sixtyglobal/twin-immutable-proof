{
	"name": "@twin.org/immutable-proof-task",
	"version": "0.0.3-next.14",
	"description": "Background proof processing that creates verifiable credentials from prepared payloads",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/immutable-proof.git",
		"directory": "packages/immutable-proof-task"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/context": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/engine-core": "next",
		"@twin.org/engine-models": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/immutable-proof-models": "0.0.3-next.14",
		"@twin.org/nameof": "next",
		"@twin.org/notarization-models": "next",
		"@twin.org/standards-w3c-did": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/identity-connector-entity-storage": "next",
		"@twin.org/notarization-connector-entity-storage": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/vault-models": "next",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.6",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.6"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"immutable-proof"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/immutable-proof/issues"
	},
	"homepage": "https://twindev.org"
}
